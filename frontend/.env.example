# Copia a .env.local si necesitas forzar la URL del backend (p. ej. IP distinta).
# Debe terminar en /api. Si solo usas `npm run dev`, suele bastar el proxy y no hace falta.
# VITE_API_URL=http://127.0.0.1:8000/api

# Opcional (Fase 7 — observabilidad): DSN de Sentry para capturar errores de
# frontend en producción. Sin esta variable, Sentry no se inicializa.
# VITE_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
