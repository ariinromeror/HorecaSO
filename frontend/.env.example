# Copia a .env.local si necesitas forzar la URL del backend (p. ej. IP distinta).
# Debe terminar en /api. Si solo usas `npm run dev`, suele bastar el proxy y no hace falta.
# VITE_API_URL=http://127.0.0.1:8000/api

# Acceso rápido del login (solo npm run dev). Copia estas claves a
# .env.development.local (gitignored) con valores reales. En producción
# no definirlas: el bloque no se renderiza (import.meta.env.DEV === false).
# VITE_DEMO_SUPERADMIN_EMAIL=
# VITE_DEMO_SUPERADMIN_PASSWORD=
# VITE_DEMO_ADMIN_EMAIL=
# VITE_DEMO_ADMIN_PASSWORD=
# VITE_DEMO_CAMARERO_EMAIL=
# VITE_DEMO_CAMARERO_PASSWORD=
# VITE_DEMO_COCINA_EMAIL=
# VITE_DEMO_COCINA_PASSWORD=
