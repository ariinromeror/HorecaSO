# Copia a .env y rellena con tus valores (Neon + Render).
# Neon: usa la cadena con pooler (host con -pooler) y termina en ?sslmode=require
# (sin channel_binding). Con pooler en modo transacción el pool ya desactiva la caché de sentencias.

DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:6543/postgres
SECRET_KEY_AUTH=genera_con_python_secrets_token_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALLOWED_ORIGINS=https://tu-app.vercel.app,http://localhost:5173
ENVIRONMENT=production
GROQ_API_KEY=
APP_NAME=HorecaSO ERP
APP_VERSION=1.0.0

# Acceso demo de un clic (POST /api/auth/demo/{rol}). Solo true en la demo pública.
DEMO_MODE=false
