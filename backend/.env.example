# Copia a .env y rellena con tus valores (Supabase + Render).
# En producción usa el pooler de Supabase (puerto 6543).

DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:6543/postgres
SECRET_KEY_AUTH=genera_con_python_secrets_token_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALLOWED_ORIGINS=https://tu-app.vercel.app,http://localhost:5173
ENVIRONMENT=production
GROQ_API_KEY=
APP_NAME=HorecaSO ERP
APP_VERSION=1.0.0

# Opcional (Fase 7 — observabilidad): DSN de Sentry para captura de
# excepciones no controladas. Sin esta variable, Sentry no se inicializa.
SENTRY_DSN=

# Fase 11 — Stripe Billing (suscripciones SaaS por tenant). URL del frontend
# usada como success_url/cancel_url/return_url en Checkout/Customer Portal.
FRONTEND_URL=http://localhost:5173
# Claves de tu cuenta Stripe (modo test primero: https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Generado por `stripe listen` en local, o por el endpoint de webhook en el
# Dashboard de Stripe en producción.
STRIPE_WEBHOOK_SECRET=
# price_id de cada Product/Price recurrente creado en el Dashboard de Stripe.
STRIPE_PRICE_BASICO=
STRIPE_PRICE_PROFESIONAL=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_ENTERPRISE=
